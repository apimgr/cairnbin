{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "gitlabci",
    "gomod",
    "jenkins"
  ],
  "pinDigests": true,
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": false,
      "pinDigests": true
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false
  }
}
