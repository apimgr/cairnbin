{{define "meta"}}
    <title>{{tf .Lang "pagemeta.home_title" "site" .SiteTitle}}</title>
    <meta name="description" content="{{t .Lang "pagemeta.home_description"}}">
{{end}}

{{define "content"}}
        <!-- Hero Section -->
        <section class="hero">
            <div class="container">
                <div class="hero-content">
                    <div class="hero-badge">
                        <span class="hero-badge-dot"></span>
                        <span>{{t .Lang "home.hero_badge"}}</span>
                    </div>
                    <h1 class="hero-title">
                        {{t .Lang "home.hero_title_1"}} <span class="hero-title-gradient">{{t .Lang "home.hero_title_2"}}</span>
                    </h1>
                    <p class="hero-description">
                        {{t .Lang "home.hero_description"}}
                    </p>
                    <div class="hero-actions">
                        <a href="{{.AssetPrefix}}/create" class="btn btn-primary btn-lg">
                            {{t .Lang "home.create_paste"}}
                        </a>
                        <a href="{{.AssetPrefix}}/recent" class="btn btn-secondary btn-lg">
                            {{t .Lang "home.browse_recent"}}
                        </a>
                    </div>
                    <div class="hero-stats">
                        <div class="hero-stat">
                            <div class="hero-stat-value">15+</div>
                            <div class="hero-stat-label">{{t .Lang "home.stat_languages"}}</div>
                        </div>
                        <div class="hero-stat">
                            <div class="hero-stat-value">REST</div>
                            <div class="hero-stat-label">{{t .Lang "home.stat_api"}}</div>
                        </div>
                        <div class="hero-stat">
                            <div class="hero-stat-value">100%</div>
                            <div class="hero-stat-label">{{t .Lang "home.stat_free"}}</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section class="features">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title">{{t .Lang "home.features_title"}}</h2>
                    <p class="section-description">{{t .Lang "home.features_desc"}}</p>
                </div>
                <div class="features-grid">
                    <a href="{{.AssetPrefix}}/create" class="feature-card">
                        <div class="feature-icon" aria-hidden="true">📝</div>
                        <h3 class="feature-title">{{t .Lang "home.feature_create_title"}}</h3>
                        <p class="feature-description">{{t .Lang "home.feature_create_desc"}}</p>
                    </a>
                    <a href="{{.AssetPrefix}}/recent" class="feature-card">
                        <div class="feature-icon" aria-hidden="true">📋</div>
                        <h3 class="feature-title">{{t .Lang "home.feature_recent_title"}}</h3>
                        <p class="feature-description">{{t .Lang "home.feature_recent_desc"}}</p>
                    </a>
                    <a href="{{.AssetPrefix}}/server/help" class="feature-card">
                        <div class="feature-icon" aria-hidden="true">⚡</div>
                        <h3 class="feature-title">{{t .Lang "home.feature_api_title"}}</h3>
                        <p class="feature-description">{{t .Lang "home.feature_api_desc"}}</p>
                    </a>
                </div>
            </div>
        </section>

        <!-- Quick Start Section -->
        <section class="search-section">
            <div class="container container-sm">
                <div class="section-header">
                    <h2 class="section-title">{{t .Lang "home.quickstart_title"}}</h2>
                    <p class="section-description">{{t .Lang "home.quickstart_desc"}}</p>
                </div>

                <div class="code-block-multi">
                    <div class="code-header">
                        <span class="code-lang">Bash</span>
                        <button type="button" class="copy-btn" data-copy-target="quickstart-upload-file" aria-live="polite" aria-label="{{t .Lang "common.copy"}}">
                            <span class="copy-icon" aria-hidden="true">📋</span><span class="copy-text">{{t .Lang "common.copy"}}</span>
                        </button>
                    </div>
                    <pre><code id="quickstart-upload-file">curl -q -LSsf -X POST --data-binary @file.txt {{.BaseURL}}/api/v1/pastes</code></pre>
                </div>

                <div class="code-block-multi">
                    <div class="code-header">
                        <span class="code-lang">Bash</span>
                        <button type="button" class="copy-btn" data-copy-target="quickstart-upload-form" aria-live="polite" aria-label="{{t .Lang "common.copy"}}">
                            <span class="copy-icon" aria-hidden="true">📋</span><span class="copy-text">{{t .Lang "common.copy"}}</span>
                        </button>
                    </div>
                    <pre><code id="quickstart-upload-form">curl -q -LSsf -X POST -F "files=@code.py" {{.BaseURL}}/api/v1/pastes</code></pre>
                </div>

                <div class="code-block-multi">
                    <div class="code-header">
                        <span class="code-lang">Bash</span>
                        <button type="button" class="copy-btn" data-copy-target="quickstart-json-api" aria-live="polite" aria-label="{{t .Lang "common.copy"}}">
                            <span class="copy-icon" aria-hidden="true">📋</span><span class="copy-text">{{t .Lang "common.copy"}}</span>
                        </button>
                    </div>
                    <pre><code id="quickstart-json-api">curl -q -LSsf -H "Content-Type: application/json" \
     -H "Accept: application/json" \
     -d '{"content":"Hello World","language":"text"}' \
     {{.BaseURL}}/api/v1/pastes</code></pre>
                </div>

                <div class="code-block-multi">
                    <div class="code-header">
                        <span class="code-lang">Bash</span>
                        <button type="button" class="copy-btn" data-copy-target="quickstart-pipe" aria-live="polite" aria-label="{{t .Lang "common.copy"}}">
                            <span class="copy-icon" aria-hidden="true">📋</span><span class="copy-text">{{t .Lang "common.copy"}}</span>
                        </button>
                    </div>
                    <pre><code id="quickstart-pipe">echo "Hello World" | curl -q -LSsf -X POST --data-binary @- {{.BaseURL}}/api/v1/pastes</code></pre>
                </div>
            </div>
        </section>
{{end}}
