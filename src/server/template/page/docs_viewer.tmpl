{{define "meta" -}}
<title>{{.ViewerTitle}}{{.TitleSeparator}}{{.SiteTitle}}</title>
<meta name="description" content="{{.ViewerLead}}">
{{end}}

{{define "content"}}
  <div class="container container-lg">
    <header class="page-header">
      <h1 class="page-title">{{.ViewerTitle}}</h1>
      <p class="page-lead">{{.ViewerLead}}</p>
    </header>
    <section class="section-card" aria-labelledby="api-explorer-heading">
      <h2 id="api-explorer-heading">{{.ViewerSection}}</h2>
      {{.ViewerContent}}
    </section>
    <noscript>
      <section class="section-card" aria-labelledby="docs-javascript-heading">
        <h2 id="docs-javascript-heading">{{t .Lang "docs.javascript_required"}}</h2>
        <p>{{t .Lang "docs.javascript_fallback"}}</p>
        <ul>
          <li><a href="{{.AssetPrefix}}{{.APIBase}}/server/swagger">{{t .Lang "docs.openapi_json"}}</a></li>
          <li><a href="{{.AssetPrefix}}{{.APIBase}}/server/graphql">{{t .Lang "docs.graphql_endpoint"}}</a></li>
        </ul>
      </section>
    </noscript>
  </div>
{{end}}
