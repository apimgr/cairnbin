{{define "meta" -}}
<title>{{t .Lang "about.title"}}{{.TitleSeparator}}{{.SiteTitle}}</title>
<meta name="description" content="{{tf .Lang "about.meta_description" "title" .SiteTitle}}">
{{end}}

{{define "content"}}
    <div class="container container-sm">
      <header class="page-header">
        <h1 class="page-title">{{t .Lang "about.title"}} {{.SiteTitle}}</h1>
        <p class="page-lead">{{.Tagline}}</p>
      </header>

        <section class="section-card" aria-labelledby="about-overview-heading">
          <h2 id="about-overview-heading">{{tf .Lang "about.what_is" "title" .SiteTitle}}</h2>
          <p>{{.Description}}</p>

          <h3>{{t .Lang "about.features"}}</h3>
          <ul class="feature-list">
            {{range .Features}}<li>{{.}}</li>
            {{end}}
          </ul>

          <h3>{{t .Lang "about.version"}}</h3>
          <p class="long-string">{{.Version}} ({{.BuildDate}})</p>

          <h3>{{t .Lang "about.source"}}</h3>
          <p class="about-links">
            {{range .Links}}<a href="{{.URL}}" target="_blank" rel="noopener">{{.Label}}</a>
            {{end}}
          </p>
          <p>{{t .Lang "about.license_note"}}</p>

          {{if .GeoIPEnabled}}
          <h3>{{t .Lang "about.attribution"}}</h3>
          <p><a href="https://db-ip.com/" target="_blank" rel="noopener">{{t .Lang "about.attribution_geoip"}}</a></p>
          <p>{{t .Lang "about.attribution_nro"}}</p>
          {{end}}
          {{if .OperatorAboutHTML}}<div class="markdown-content">{{.OperatorAboutHTML}}</div>{{end}}
        </section>
    </div>
{{end}}
