{{define "meta"}}
    <title>{{t .Lang "preferences.title"}} - {{.SiteTitle}}</title>
    <meta name="description" content="{{t .Lang "preferences.description"}}">
{{end}}

{{define "content"}}
        <section class="search-section">
            <div class="container container-sm">
                <div class="section-header">
                    <h1 class="section-title">{{t .Lang "preferences.title"}}</h1>
                </div>

                <div class="paste-view page-view">
                    <p>{{t .Lang "preferences.intro"}}</p>
                    <p class="alert">
                        <strong>{{t .Lang "preferences.current"}}:</strong>
                        {{t .Lang "preferences.theme_label"}} = {{t .Lang (print "theme." .PrefTheme)}},
                        {{t .Lang "preferences.lang_label"}} = {{t .Lang (print "lang." .PrefLang)}}
                    </p>
                    {{if .GPCReceived}}
                    <p class="alert" role="status">{{t .Lang "preferences.gpc_notice"}}</p>
                    {{end}}

                    <form method="POST" action="/server/preferences" class="pref-form">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <input type="hidden" name="consent_form" value="1">
                        <input type="hidden" name="redirect" value="{{.CancelURL}}">
                        <h2 class="section-mt">{{t .Lang "preferences.theme_label"}}</h2>
                        <p>{{t .Lang "preferences.theme_desc"}}</p>
                        <fieldset class="form-group">
                            <legend>{{t .Lang "preferences.theme_label"}}</legend>
                            {{range $mode := (list "dark" "light" "auto")}}
                            <label><input type="radio" name="theme" value="{{$mode}}"{{if eq $.PrefTheme $mode}} checked{{end}}> {{t $.Lang (print "theme." $mode)}}</label>
                            {{end}}
                        </fieldset>
                        <h2 class="section-mt">{{t .Lang "preferences.lang_label"}}</h2>
                        <label class="form-label" for="pref-language">{{t .Lang "preferences.lang_label"}}</label>
                        <select id="pref-language" name="lang" class="form-select">
                            {{range $code := (list "en" "es" "fr" "de" "zh" "ar" "ja")}}
                            <option value="{{$code}}"{{if eq $.PrefLang $code}} selected{{end}}>{{t $.Lang (print "lang." $code)}}</option>
                            {{end}}
                        </select>
                        <h2 class="section-mt">{{t .Lang "preferences.consent_title"}}</h2>
                        <p>{{t .Lang "preferences.consent_desc"}}</p>
                        {{$c := consentInfo}}
                        <p class="cookie-category"><label><input type="checkbox" checked disabled><span>{{$c.Descriptions.Essential}}</span></label></p>
                        <p class="cookie-category"><label><input type="checkbox" name="consent_preferences" value="1"{{if .ConsentPreferences}} checked{{end}}><span>{{$c.Descriptions.Preferences}}</span></label></p>
                        <p class="cookie-category"><label><input type="checkbox" name="consent_analytics" value="1"{{if .ConsentAnalytics}} checked{{end}}{{if not .ConsentAnalyticsConfigured}} disabled{{end}}><span>{{$c.Descriptions.Analytics}}</span></label></p>
                        <p class="cookie-category"><label><input type="checkbox" name="ccpa_opt_out" value="1"{{if .CCPAOptedOut}} checked{{end}}><span>{{t .Lang "privacy.ccpa_do_not_sell"}}</span></label></p>
                        <h2 class="section-mt">{{t .Lang "preferences.app_pref_title"}}</h2>
                        <p>{{t .Lang "preferences.app_pref_desc"}}</p>
                        <label class="form-label" for="pref-sort">{{t .Lang "recent.sort_label"}}</label>
                        <select id="pref-sort" name="cairnbin_pref_sort" class="form-select">
                            {{$sort := .PrefSort}}{{range $col := (list "date" "name" "views")}}<option value="{{$col}}"{{if eq $sort $col}} selected{{end}}>{{t $.Lang (print "recent.sort_" $col)}}</option>{{end}}
                        </select>
                        <label class="form-label" for="pref-order">{{t .Lang "recent.order_label"}}</label>
                        <select id="pref-order" name="cairnbin_pref_order" class="form-select">
                            {{$order := .PrefOrder}}<option value="desc"{{if eq $order "desc"}} selected{{end}}>{{t .Lang "recent.order_desc"}}</option><option value="asc"{{if eq $order "asc"}} selected{{end}}>{{t .Lang "recent.order_asc"}}</option>
                        </select>
                        <label class="form-label" for="pref-per-page">{{t .Lang "recent.limit_label"}}</label>
                        <select id="pref-per-page" name="cairnbin_pref_per_page" class="form-select">
                            {{$perPage := .PrefPerPage}}{{range $n := (list "20" "50" "100" "250")}}<option value="{{$n}}"{{if eq $perPage $n}} selected{{end}}>{{$n}}</option>{{end}}
                        </select>
                        <h2 class="section-mt">{{t .Lang "preferences.export_title"}}</h2>
                        <label class="form-label" for="pref-export-url">{{t .Lang "preferences.export_url"}}</label>
                        <div class="copy-field"><input type="text" id="pref-export-url" class="form-input long-string preferences-export-value" value="{{.ExportURL}}" readonly><button type="button" class="copy-btn" data-copy="{{.ExportURL}}" aria-label="{{t .Lang "preferences.copy"}}">{{t .Lang "preferences.copy"}}</button></div>
                        <label class="form-label" for="pref-export-code">{{t .Lang "preferences.export_code"}}</label>
                        <div class="copy-field"><input type="text" id="pref-export-code" class="form-input long-string preferences-export-value" value="{{.ExportCode}}" readonly><button type="button" class="copy-btn" data-copy="{{.ExportCode}}" aria-label="{{t .Lang "preferences.copy"}}">{{t .Lang "preferences.copy"}}</button></div>
                        <label class="form-label" for="pref-import-code">{{t .Lang "preferences.import_code"}}</label>
                        <input type="text" id="pref-import-code" name="code" class="form-input long-string preferences-export-value" maxlength="2048" placeholder="{{t .Lang "preferences.import_placeholder"}}">
                        <div class="form-actions">
                            <a class="btn btn-secondary" href="{{.CancelURL}}">{{t .Lang "common.cancel"}}</a>
                            <button type="button" class="btn btn-secondary" popovertarget="preferences-reset">{{t .Lang "preferences.reset"}}</button>
                            <button type="submit" class="btn btn-primary">{{t .Lang "common.save"}}</button>
                        </div>
                        <div id="preferences-reset" popover>
                            <p>{{t .Lang "preferences.reset_warning"}}</p>
                            <button type="button" class="btn btn-secondary" popovertarget="preferences-reset" popovertargetaction="hide">{{t .Lang "common.cancel"}}</button>
                            <button type="submit" class="btn btn-danger" name="action" value="reset">{{t .Lang "preferences.erase"}}</button>
                        </div>
                    </form>

                    <h2 class="section-mt">{{t .Lang "preferences.token_title"}}</h2>
                    <p>{{t .Lang "preferences.token_desc"}}</p>
                    <p><button type="button" class="btn btn-secondary" data-action="forget-token">{{t .Lang "paste.forget_token"}}</button></p>
                    {{if .HasOwnerPrimary}}
                    <h3>{{t .Lang "preferences.owner_tokens"}}</h3>
                    {{range .OwnerTokens}}
                    <p>{{if eq .kind "primary"}}{{t $.Lang "preferences.owner_primary"}}{{else}}{{t $.Lang "preferences.owner_linked"}}{{end}} {{.name}}: <code>{{.token}}</code> ({{t $.Lang (print "preferences.owner_" .status)}})</p>
                    {{if eq .kind "linked"}}
                    <form method="post" action="{{$.AssetPrefix}}/server/preferences/tokens/{{.id}}/reveal" class="pref-option-form">
                        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                        <button type="submit" class="btn btn-secondary">{{t $.Lang "preferences.owner_reveal"}}</button>
                    </form>
                    <form method="post" action="{{$.AssetPrefix}}/server/preferences/tokens/{{.id}}/rotate" class="pref-option-form" data-confirm="{{t $.Lang "preferences.owner_confirm_rotate"}}">
                        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                        <button type="submit" class="btn btn-secondary">{{t $.Lang "preferences.owner_rotate"}}</button>
                    </form>
                    <form method="post" action="{{$.AssetPrefix}}/server/preferences/tokens/{{.id}}/update" class="pref-form">
                        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                        <label class="form-label" for="tok-{{.id}}-name">{{t $.Lang "preferences.owner_rename"}}</label><input id="tok-{{.id}}-name" name="name" value="{{.name}}" maxlength="64" required class="form-input">
                        <label class="form-label" for="tok-{{.id}}-expires">{{t $.Lang "preferences.owner_expiry"}}</label><select id="tok-{{.id}}-expires" name="expires" class="form-select"><option value="" selected>{{t $.Lang "preferences.owner_keep_expiry"}}</option><option value="never">{{t $.Lang "preferences.owner_never"}}</option><option value="7d">{{t $.Lang "preferences.owner_7_days"}}</option><option value="30d">{{t $.Lang "preferences.owner_30_days"}}</option><option value="90d">{{t $.Lang "preferences.owner_90_days"}}</option><option value="1y">{{t $.Lang "preferences.owner_1_year"}}</option></select>
                        <label class="form-label" for="tok-{{.id}}-date">{{t $.Lang "preferences.owner_expiry"}}</label><input id="tok-{{.id}}-date" type="date" name="expires_date" class="form-input">
                        <button type="submit" class="btn btn-secondary">{{t $.Lang "preferences.owner_save"}}</button>
                    </form>
                    <form method="post" action="{{$.AssetPrefix}}/server/preferences/tokens/{{.id}}/revoke" class="pref-option-form" data-confirm="{{t $.Lang "preferences.owner_confirm_revoke"}}">
                        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                        <button type="submit" class="btn btn-secondary">{{t $.Lang "preferences.owner_revoke"}}</button>
                    </form>
                    {{end}}
                    {{end}}
                    <form method="post" action="{{.AssetPrefix}}/server/preferences/tokens" class="pref-form">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <label for="linked-token-name" class="form-label">{{t .Lang "preferences.owner_create_linked"}}</label>
                        <input id="linked-token-name" name="name" maxlength="64" required class="form-input">
                        <label for="linked-token-expiry" class="form-label">{{t .Lang "preferences.owner_expiry"}}</label>
                        <select id="linked-token-expiry" name="expires" class="form-select"><option value="never">{{t .Lang "preferences.owner_never"}}</option><option value="7d">{{t .Lang "preferences.owner_7_days"}}</option><option value="30d">{{t .Lang "preferences.owner_30_days"}}</option><option value="90d">{{t .Lang "preferences.owner_90_days"}}</option><option value="1y">{{t .Lang "preferences.owner_1_year"}}</option></select>
                        <label class="form-label" for="linked-token-date">{{t .Lang "preferences.owner_expiry"}}</label><input id="linked-token-date" type="date" name="expires_date" class="form-input">
                        <button type="submit" class="btn btn-primary">{{t .Lang "preferences.owner_create"}}</button>
                    </form>
                    <form method="post" action="{{.AssetPrefix}}/server/preferences/token/reveal" class="pref-form">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <button type="submit" class="btn btn-secondary">{{t .Lang "preferences.owner_reveal"}} {{t .Lang "preferences.owner_primary"}}</button>
                    </form>
                    <form method="post" action="{{.AssetPrefix}}/server/preferences/token/rotate" class="pref-form" data-confirm="{{t .Lang "preferences.owner_confirm_rotate_primary"}}">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <button type="submit" class="btn btn-secondary">{{t .Lang "preferences.owner_rotate"}} {{t .Lang "preferences.owner_primary"}}</button>
                    </form>
                    {{if .RevealedOwnerToken}}
                    <p>{{t .Lang "preferences.owner_primary"}}: <code class="long-string">{{.RevealedOwnerToken}}</code> <button type="button" class="copy-btn" data-copy="{{.RevealedOwnerToken}}" aria-label="{{t .Lang "preferences.owner_copy"}}">{{t .Lang "preferences.owner_copy"}}</button></p>
                    {{end}}
                    {{if .RevealedLinkedToken}}
                    <p>{{t .Lang "preferences.owner_linked"}}: <code class="long-string">{{.RevealedLinkedToken}}</code> <button type="button" class="copy-btn" data-copy="{{.RevealedLinkedToken}}">{{t .Lang "preferences.owner_copy"}}</button></p>
                    {{end}}
                    {{else}}
                    <form method="post" action="{{.AssetPrefix}}/server/preferences/token/restore" class="pref-form">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <label for="restore-owner-token" class="form-label">{{t .Lang "preferences.owner_use_primary"}}</label>
                        <input id="restore-owner-token" name="owner_token" type="password" class="form-input" required autocomplete="off">
                        <button type="submit" class="btn btn-secondary">{{t .Lang "preferences.owner_restore"}}</button>
                    </form>
                    {{end}}

                </div>
            </div>
        </section>
{{end}}
