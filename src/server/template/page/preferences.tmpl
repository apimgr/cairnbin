{{define "meta" -}}
<title>{{t .Lang "preferences.title"}}{{.TitleSeparator}}{{.SiteTitle}}</title>
<meta name="description" content="{{t .Lang "preferences.description"}}">
{{end}}

{{define "content"}}
  <div class="container container-md">
    <header class="page-header">
      <h1 class="page-title">{{t .Lang "preferences.title"}}</h1>
      <p class="page-lead">{{t .Lang "preferences.intro"}}</p>
    </header>

    {{if .GPCReceived}}<p class="alert alert-info" role="status">{{t .Lang "preferences.gpc_notice"}}</p>{{end}}
    <form method="post" action="/server/preferences">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="consent_form" value="1">
      <input type="hidden" name="redirect" value="{{.CancelURL}}">

      <section class="section-card" aria-labelledby="preferences-appearance">
        <h2 id="preferences-appearance">{{t .Lang "preferences.theme_label"}}</h2>
        <p>{{t .Lang "preferences.theme_desc"}}</p>
        <fieldset class="form-group">
          <legend>{{t .Lang "preferences.theme_label"}}</legend>
          {{range $mode := (list "dark" "light" "auto")}}
          <label class="form-option"><input type="radio" name="theme" value="{{$mode}}"{{if eq $.PrefTheme $mode}} checked{{end}}> {{t $.Lang (print "theme." $mode)}}</label>
          {{end}}
        </fieldset>
      </section>

      <section class="section-card" aria-labelledby="language">
        <h2 id="language">{{t .Lang "preferences.lang_label"}}</h2>
        <div class="form-group">
          <label class="form-label" for="pref-language">{{t .Lang "preferences.lang_label"}}</label>
          <select id="pref-language" name="lang" class="form-input">
            <option value="auto"{{if eq .PrefLangChoice "auto"}} selected{{end}}>{{t .Lang "preferences.automatic"}} ({{.AutomaticLanguageName}})</option>
            {{range .AvailableLanguages}}
            <option value="{{.Code}}" lang="{{.Code}}"{{if eq $.PrefLangChoice .Code}} selected{{end}}>{{.NativeName}}</option>
            {{end}}
          </select>
        </div>
      </section>

      <section class="section-card" aria-labelledby="preferences-privacy">
        <h2 id="preferences-privacy">{{t .Lang "preferences.consent_title"}}</h2>
        <p>{{t .Lang "preferences.consent_desc"}}</p>
        {{$c := consentInfo .Lang}}
        <div class="form-group">
          <label class="form-option"><input type="checkbox" checked disabled><span>{{$c.Descriptions.Essential}}</span></label>
          <label class="form-option"><input type="checkbox" name="consent_preferences" value="1"{{if .ConsentPreferences}} checked{{end}}><span>{{$c.Descriptions.Preferences}}</span></label>
          <label class="form-option"><input type="checkbox" name="consent_analytics" value="1"{{if .ConsentAnalytics}} checked{{end}}{{if not .ConsentAnalyticsConfigured}} disabled{{end}}><span>{{$c.Descriptions.Analytics}}</span></label>
          {{if .CCPAEnabled}}<label class="form-option"><input type="checkbox" name="ccpa_opt_out" value="1"{{if .CCPAOptedOut}} checked{{end}}><span>{{t .Lang "privacy.ccpa_do_not_sell"}}</span></label>{{end}}
        </div>
      </section>

      <section class="section-card" aria-labelledby="preferences-application">
        <h2 id="preferences-application">{{t .Lang "preferences.app_pref_title"}}</h2>
        <p>{{t .Lang "preferences.app_pref_desc"}}</p>
        <div class="form-group">
          <label class="form-label" for="pref-sort">{{t .Lang "recent.sort_label"}}</label>
          <select id="pref-sort" name="cairnbin_pref_sort" class="form-input">
            {{$sort := .PrefSort}}{{range $col := (list "date" "name" "views")}}<option value="{{$col}}"{{if eq $sort $col}} selected{{end}}>{{t $.Lang (print "recent.sort_" $col)}}</option>{{end}}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="pref-order">{{t .Lang "recent.order_label"}}</label>
          <select id="pref-order" name="cairnbin_pref_order" class="form-input">
            {{$order := .PrefOrder}}<option value="desc"{{if eq $order "desc"}} selected{{end}}>{{t .Lang "recent.order_desc"}}</option><option value="asc"{{if eq $order "asc"}} selected{{end}}>{{t .Lang "recent.order_asc"}}</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="pref-per-page">{{t .Lang "recent.limit_label"}}</label>
          <select id="pref-per-page" name="cairnbin_pref_per_page" class="form-input">
            {{$perPage := .PrefPerPage}}{{range $n := (list "20" "50" "100" "250")}}<option value="{{$n}}"{{if eq $perPage $n}} selected{{end}}>{{$n}}</option>{{end}}
          </select>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">{{t .Lang "common.save"}}</button>
          <a class="btn btn-secondary" href="{{.CancelURL}}">{{t .Lang "common.cancel"}}</a>
          <button type="button" class="btn btn-danger" popovertarget="preferences-reset">{{t .Lang "preferences.reset"}}</button>
        </div>
        <div id="preferences-reset" popover>
          <p>{{t .Lang "preferences.reset_warning"}}</p>
          <button type="submit" class="btn btn-danger" name="action" value="reset">{{t .Lang "preferences.erase"}}</button>
          <button type="button" class="btn btn-secondary" popovertarget="preferences-reset" popovertargetaction="hide">{{t .Lang "common.cancel"}}</button>
        </div>
      </section>
    </form>

    <section class="section-card" aria-labelledby="more-preferences">
      <h2 id="more-preferences">{{t .Lang "preferences.more"}}</h2>
      <ul class="hub-list">
        {{range .RegisteredPreferences}}
        <li class="hub-item"><a class="hub-link" href="{{.Path}}"><span class="hub-title">{{.Title}}</span><span class="hub-desc">{{.Description}}</span></a></li>
        {{end}}
      </ul>
    </section>
  </div>
{{end}}
