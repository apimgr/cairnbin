{{define "meta"}}
    <title>{{t .Lang "preferences.title"}} - {{.SiteTitle}}</title>
    <meta name="description" content="{{t .Lang "preferences.description"}}">
{{end}}

{{define "content"}}
        <section class="search-section">
            <div class="container container-sm">
                <div class="section-header">
                    <h1 class="section-title">{{t .Lang "preferences.title"}}</h1>
                </div>

                <div class="paste-view page-view">
                    <p>{{t .Lang "preferences.intro"}}</p>
                    <p class="alert">
                        <strong>{{t .Lang "preferences.current"}}:</strong>
                        {{t .Lang "preferences.theme_label"}} = {{t .Lang (print "theme." .PrefTheme)}},
                        {{t .Lang "preferences.lang_label"}} = {{t .Lang (print "lang." .PrefLang)}}
                    </p>

                    <h2 class="section-mt">{{t .Lang "preferences.theme_label"}}</h2>
                    <p>{{t .Lang "preferences.theme_desc"}}</p>
                    <div class="pref-options" role="group" aria-label="{{t .Lang "preferences.theme_label"}}">
                        {{range $mode := (list "dark" "light" "auto")}}
                        <form method="post" action="{{$.AssetPrefix}}/server/preferences" class="pref-option-form">
                            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                            <input type="hidden" name="theme" value="{{$mode}}">
                            <button type="submit" class="btn {{if eq $.PrefTheme $mode}}btn-primary{{else}}btn-secondary{{end}}"
                                    aria-pressed="{{if eq $.PrefTheme $mode}}true{{else}}false{{end}}"
                                    data-action="submit-loading" data-loading-text="{{t $.Lang "js.saving"}}">{{t $.Lang (print "theme." $mode)}}</button>
                        </form>
                        {{end}}
                    </div>

                    <h2 class="section-mt">{{t .Lang "preferences.lang_label"}}</h2>
                    <p>{{t .Lang "preferences.lang_desc"}}</p>
                    <div class="pref-options" role="group" aria-label="{{t .Lang "preferences.lang_label"}}">
                        {{range $code := (list "en" "es" "fr" "de" "zh" "ar" "ja")}}
                        <a href="{{$.AssetPrefix}}/server/preferences?lang={{$code}}"
                           class="btn {{if eq $.PrefLang $code}}btn-primary{{else}}btn-secondary{{end}}"
                           aria-pressed="{{if eq $.PrefLang $code}}true{{else}}false{{end}}">{{t $.Lang (print "lang." $code)}}</a>
                        {{end}}
                    </div>

                    <h2 class="section-mt">{{t .Lang "preferences.app_pref_title"}}</h2>
                    <p>{{t .Lang "preferences.app_pref_desc"}}</p>
                    <form method="post" action="{{.AssetPrefix}}/server/preferences" class="pref-form">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <div class="form-group">
                            <label class="form-label" for="pref-sort">{{t .Lang "recent.sort_label"}}</label>
                            <select id="pref-sort" name="pastebin_pref_sort" class="form-select">
                                {{$sort := .PrefSort}}
                                {{range $col := (list "date" "name" "views")}}
                                <option value="{{$col}}" {{if eq $sort $col}}selected{{end}}>{{t $.Lang (print "recent.sort_" $col)}}</option>
                                {{end}}
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="pref-order">{{t .Lang "recent.order_label"}}</label>
                            <select id="pref-order" name="pastebin_pref_order" class="form-select">
                                {{$order := .PrefOrder}}
                                <option value="desc" {{if eq $order "desc"}}selected{{end}}>{{t .Lang "recent.order_desc"}}</option>
                                <option value="asc" {{if eq $order "asc"}}selected{{end}}>{{t .Lang "recent.order_asc"}}</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="pref-per-page">{{t .Lang "recent.limit_label"}}</label>
                            <select id="pref-per-page" name="pastebin_pref_per_page" class="form-select">
                                {{$perPage := .PrefPerPage}}
                                {{range $n := (list "20" "50" "100" "250")}}
                                <option value="{{$n}}" {{if eq $perPage $n}}selected{{end}}>{{$n}}</option>
                                {{end}}
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary"
                                data-action="submit-loading" data-loading-text="{{t .Lang "js.saving"}}">{{t .Lang "common.save"}}</button>
                    </form>

                    <h2 class="section-mt">{{t .Lang "preferences.token_title"}}</h2>
                    <p>{{t .Lang "preferences.token_desc"}}</p>
                    <p><button type="button" class="btn btn-secondary" data-action="forget-token">{{t .Lang "paste.forget_token"}}</button></p>
                    {{if .HasOwnerPrimary}}
                    <h3>{{t .Lang "preferences.owner_tokens"}}</h3>
                    {{range .OwnerTokens}}
                    <p>{{if eq .kind "primary"}}{{t $.Lang "preferences.owner_primary"}}{{else}}{{t $.Lang "preferences.owner_linked"}}{{end}} {{.name}}: <code>{{.token}}</code> ({{t $.Lang (print "preferences.owner_" .status)}})</p>
                    {{if eq .kind "linked"}}
                    <form method="post" action="{{$.AssetPrefix}}/server/preferences/tokens/{{.id}}/reveal" class="pref-option-form">
                        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                        <button type="submit" class="btn btn-secondary">{{t $.Lang "preferences.owner_reveal"}}</button>
                    </form>
                    <form method="post" action="{{$.AssetPrefix}}/server/preferences/tokens/{{.id}}/rotate" class="pref-option-form" onsubmit="return confirm('{{t $.Lang "preferences.owner_confirm_rotate"}}');">
                        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                        <button type="submit" class="btn btn-secondary">{{t $.Lang "preferences.owner_rotate"}}</button>
                    </form>
                    <form method="post" action="{{$.AssetPrefix}}/server/preferences/tokens/{{.id}}/update" class="pref-form">
                        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                        <label class="form-label">{{t $.Lang "preferences.owner_rename"}}</label><input name="name" value="{{.name}}" maxlength="64" required class="form-input">
                        <label class="form-label">{{t $.Lang "preferences.owner_expiry"}}</label><select name="expires" class="form-select"><option value="" selected>{{t $.Lang "preferences.owner_keep_expiry"}}</option><option value="never">{{t $.Lang "preferences.owner_never"}}</option><option value="7d">{{t $.Lang "preferences.owner_7_days"}}</option><option value="30d">{{t $.Lang "preferences.owner_30_days"}}</option><option value="90d">{{t $.Lang "preferences.owner_90_days"}}</option><option value="1y">{{t $.Lang "preferences.owner_1_year"}}</option></select>
                        <label class="form-label">{{t $.Lang "preferences.owner_expiry"}}</label><input type="date" name="expires_date" class="form-input">
                        <button type="submit" class="btn btn-secondary">{{t $.Lang "preferences.owner_save"}}</button>
                    </form>
                    <form method="post" action="{{$.AssetPrefix}}/server/preferences/tokens/{{.id}}/revoke" class="pref-option-form" onsubmit="return confirm('{{t $.Lang "preferences.owner_confirm_revoke"}}');">
                        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                        <button type="submit" class="btn btn-secondary">{{t $.Lang "preferences.owner_revoke"}}</button>
                    </form>
                    {{end}}
                    {{end}}
                    <form method="post" action="{{.AssetPrefix}}/server/preferences/tokens" class="pref-form">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <label for="linked-token-name" class="form-label">{{t .Lang "preferences.owner_create_linked"}}</label>
                        <input id="linked-token-name" name="name" maxlength="64" required class="form-input">
                        <label for="linked-token-expiry" class="form-label">{{t .Lang "preferences.owner_expiry"}}</label>
                        <select id="linked-token-expiry" name="expires" class="form-select"><option value="never">{{t .Lang "preferences.owner_never"}}</option><option value="7d">{{t .Lang "preferences.owner_7_days"}}</option><option value="30d">{{t .Lang "preferences.owner_30_days"}}</option><option value="90d">{{t .Lang "preferences.owner_90_days"}}</option><option value="1y">{{t .Lang "preferences.owner_1_year"}}</option></select>
                        <label class="form-label" for="linked-token-date">{{t .Lang "preferences.owner_expiry"}}</label><input id="linked-token-date" type="date" name="expires_date" class="form-input">
                        <button type="submit" class="btn btn-primary">{{t .Lang "preferences.owner_create"}}</button>
                    </form>
                    <form method="post" action="{{.AssetPrefix}}/server/preferences/token/reveal" class="pref-form">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <button type="submit" class="btn btn-secondary">{{t .Lang "preferences.owner_reveal"}} {{t .Lang "preferences.owner_primary"}}</button>
                    </form>
                    <form method="post" action="{{.AssetPrefix}}/server/preferences/token/rotate" class="pref-form" onsubmit="return confirm('{{t .Lang "preferences.owner_confirm_rotate_primary"}}');">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <button type="submit" class="btn btn-secondary">{{t .Lang "preferences.owner_rotate"}} {{t .Lang "preferences.owner_primary"}}</button>
                    </form>
                    {{if .RevealedOwnerToken}}
                    <p>{{t .Lang "preferences.owner_primary"}}: <code class="long-string">{{.RevealedOwnerToken}}</code> <button type="button" class="copy-btn" data-copy="{{.RevealedOwnerToken}}" aria-label="{{t .Lang "preferences.owner_copy"}}">{{t .Lang "preferences.owner_copy"}}</button></p>
                    {{end}}
                    {{if .RevealedLinkedToken}}
                    <p>{{t .Lang "preferences.owner_linked"}}: <code class="long-string">{{.RevealedLinkedToken}}</code> <button type="button" class="copy-btn" data-copy="{{.RevealedLinkedToken}}">{{t .Lang "preferences.owner_copy"}}</button></p>
                    {{end}}
                    {{else}}
                    <form method="post" action="{{.AssetPrefix}}/server/preferences/token/restore" class="pref-form">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <label for="restore-owner-token" class="form-label">{{t .Lang "preferences.owner_use_primary"}}</label>
                        <input id="restore-owner-token" name="owner_token" type="password" class="form-input" required autocomplete="off">
                        <button type="submit" class="btn btn-secondary">{{t .Lang "preferences.owner_restore"}}</button>
                    </form>
                    {{end}}

                    <h2 class="section-mt">{{t .Lang "preferences.export_title"}}</h2>
                    <p>{{t .Lang "preferences.export_desc"}}</p>
                    {{if .ExportURL}}
                    <div class="form-group">
                        <label for="pref-export-url" class="form-label">{{t .Lang "preferences.export_url"}}</label>
                        <div class="copy-field">
                            <input type="text" id="pref-export-url" class="form-input long-string" value="{{.ExportURL}}" readonly
                                   aria-describedby="pref-export-url-error" aria-invalid="false">
                            <button type="button" class="copy-btn" data-copy="{{.ExportURL}}" aria-live="polite" aria-label="{{t .Lang "preferences.copy"}}">
                                <span class="copy-text">📋</span>
                            </button>
                        </div>
                        <span id="pref-export-url-error" class="field-error" role="alert" hidden></span>
                    </div>
                    <div class="form-group">
                        <label for="pref-export-code" class="form-label">{{t .Lang "preferences.export_code"}}</label>
                        <div class="copy-field">
                            <input type="text" id="pref-export-code" class="form-input long-string" value="{{.ExportCode}}" readonly
                                   aria-describedby="pref-export-code-error" aria-invalid="false">
                            <button type="button" class="copy-btn" data-copy="{{.ExportCode}}" aria-live="polite" aria-label="{{t .Lang "preferences.copy"}}">
                                <span class="copy-text">📋</span>
                            </button>
                        </div>
                        <span id="pref-export-code-error" class="field-error" role="alert" hidden></span>
                    </div>
                    {{else}}
                    <p><a href="{{.AssetPrefix}}/server/preferences/export" class="btn btn-secondary">{{t .Lang "preferences.export_action"}}</a></p>
                    {{end}}

                    <h2 class="section-mt">{{t .Lang "preferences.import_title"}}</h2>
                    <p>{{t .Lang "preferences.import_desc"}}</p>
                    <form method="get" action="{{.AssetPrefix}}/server/preferences/import" class="contact-form">
                        <div class="form-group">
                            <label for="pref-import-code" class="form-label">{{t .Lang "preferences.import_code"}}</label>
                            <input type="text" id="pref-import-code" name="code" class="form-input long-string"
                                   maxlength="500" placeholder="{{t .Lang "preferences.import_placeholder"}}"
                                   aria-describedby="pref-import-code-error" aria-invalid="false">
                            <span id="pref-import-code-error" class="field-error" role="alert" hidden></span>
                        </div>
                        <button type="submit" class="btn btn-primary" data-action="submit-loading" data-loading-text="{{t .Lang "js.importing"}}">{{t .Lang "preferences.import_action"}}</button>
                    </form>

                    <h2 id="ccpa-opt-out" class="section-mt">{{t .Lang "privacy.ccpa_do_not_sell"}}</h2>
                    {{if .Privacy.IsCCPAApplicable}}
                        {{if .CCPAOptedOut}}
                        <p>{{t .Lang "privacy.ccpa_opted_out_full"}}</p>
                        <form method="POST" action="{{.AssetPrefix}}/server/privacy/ccpa">
                            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                            <input type="hidden" name="action" value="opt_in">
                            <button type="submit" class="btn btn-secondary" data-action="submit-loading" data-loading-text="{{t .Lang "js.saving"}}">{{t .Lang "privacy.ccpa_opt_back_in"}}</button>
                        </form>
                        {{else}}
                        <p>{{t .Lang "privacy.ccpa_intro"}}</p>
                        <form method="POST" action="{{.AssetPrefix}}/server/privacy/ccpa">
                            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                            <input type="hidden" name="action" value="opt_out">
                            <button type="submit" class="btn btn-primary" data-action="submit-loading" data-loading-text="{{t .Lang "js.saving"}}">{{t .Lang "privacy.ccpa_do_not_sell"}}</button>
                        </form>
                        {{end}}
                    {{else}}
                    <p>{{t .Lang "privacy.ccpa_not_applicable"}}</p>
                    {{end}}

                    {{$c := consentInfo}}
                    <h2 class="section-mt">{{t .Lang "preferences.consent_title"}}</h2>
                    <p>{{t .Lang "preferences.consent_desc"}}</p>
                    <form method="post" action="{{.AssetPrefix}}/server/consent" class="contact-form">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <p class="cookie-category">
                            <label>
                                <input type="checkbox" checked disabled aria-describedby="pref-consent-essential">
                                <span id="pref-consent-essential">{{$c.Descriptions.Essential}}</span>
                            </label>
                        </p>
                        <p class="cookie-category">
                            <label>
                                <input type="checkbox" name="preferences" value="1"{{if .ConsentPreferences}} checked{{end}}
                                       aria-describedby="pref-consent-preferences">
                                <span id="pref-consent-preferences">{{$c.Descriptions.Preferences}}</span>
                            </label>
                        </p>
                        {{if $c.AnalyticsConfigured}}
                        <p class="cookie-category">
                            <label>
                                <input type="checkbox" name="analytics" value="1"{{if .ConsentAnalytics}} checked{{end}}
                                       aria-describedby="pref-consent-analytics">
                                <span id="pref-consent-analytics">{{$c.Descriptions.Analytics}}</span>
                            </label>
                        </p>
                        {{end}}
                        <button type="submit" name="choice" value="save" class="btn btn-primary" data-action="submit-loading" data-loading-text="{{t .Lang "js.saving"}}">{{t .Lang "cookie_consent.save_preferences"}}</button>
                        <button type="submit" name="choice" value="decline" class="btn btn-secondary">{{t .Lang "cookie_consent.decline"}}</button>
                    </form>
                </div>
            </div>
        </section>
{{end}}
