{{define "meta"}}
    <title>{{t .Lang "preferences.title"}} - {{.SiteTitle}}</title>
    <meta name="description" content="{{t .Lang "preferences.description"}}">
{{end}}

{{define "content"}}
        <section class="search-section">
            <div class="container container-sm">
                <div class="section-header">
                    <h1 class="section-title">{{t .Lang "preferences.title"}}</h1>
                </div>

                <div class="paste-view page-view">
                    <p>{{t .Lang "preferences.intro"}}</p>
                    <p class="alert">
                        <strong>{{t .Lang "preferences.current"}}:</strong>
                        {{t .Lang "preferences.theme_label"}} = {{t .Lang (print "theme." .PrefTheme)}},
                        {{t .Lang "preferences.lang_label"}} = {{t .Lang (print "lang." .PrefLang)}}
                    </p>
                    {{if .GPCReceived}}
                    <p class="alert" role="status">{{t .Lang "preferences.gpc_notice"}}</p>
                    {{end}}

                    <form method="POST" action="/server/preferences" class="pref-form">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <input type="hidden" name="consent_form" value="1">
                        <input type="hidden" name="redirect" value="{{.CancelURL}}">
                        <h2 class="section-mt">{{t .Lang "preferences.theme_label"}}</h2>
                        <p>{{t .Lang "preferences.theme_desc"}}</p>
                        <fieldset class="form-group">
                            <legend>{{t .Lang "preferences.theme_label"}}</legend>
                            {{range $mode := (list "dark" "light" "auto")}}
                            <label><input type="radio" name="theme" value="{{$mode}}"{{if eq $.PrefTheme $mode}} checked{{end}}> {{t $.Lang (print "theme." $mode)}}</label>
                            {{end}}
                        </fieldset>
                        <h2 class="section-mt">{{t .Lang "preferences.lang_label"}}</h2>
                        <label class="form-label" for="pref-language">{{t .Lang "preferences.lang_label"}}</label>
                        <select id="pref-language" name="lang" class="form-select">
                            {{range $code := (list "en" "es" "fr" "de" "zh" "ar" "ja")}}
                            <option value="{{$code}}"{{if eq $.PrefLang $code}} selected{{end}}>{{t $.Lang (print "lang." $code)}}</option>
                            {{end}}
                        </select>
                        <h2 class="section-mt">{{t .Lang "preferences.consent_title"}}</h2>
                        <p>{{t .Lang "preferences.consent_desc"}}</p>
                        {{$c := consentInfo .Lang}}
                        <p class="cookie-category"><label><input type="checkbox" checked disabled><span>{{$c.Descriptions.Essential}}</span></label></p>
                        <p class="cookie-category"><label><input type="checkbox" name="consent_preferences" value="1"{{if .ConsentPreferences}} checked{{end}}><span>{{$c.Descriptions.Preferences}}</span></label></p>
                        <p class="cookie-category"><label><input type="checkbox" name="consent_analytics" value="1"{{if .ConsentAnalytics}} checked{{end}}{{if not .ConsentAnalyticsConfigured}} disabled{{end}}><span>{{$c.Descriptions.Analytics}}</span></label></p>
                        <p class="cookie-category"><label><input type="checkbox" name="ccpa_opt_out" value="1"{{if .CCPAOptedOut}} checked{{end}}><span>{{t .Lang "privacy.ccpa_do_not_sell"}}</span></label></p>
                        <h2 class="section-mt">{{t .Lang "preferences.app_pref_title"}}</h2>
                        <p>{{t .Lang "preferences.app_pref_desc"}}</p>
                        <label class="form-label" for="pref-sort">{{t .Lang "recent.sort_label"}}</label>
                        <select id="pref-sort" name="cairnbin_pref_sort" class="form-select">
                            {{$sort := .PrefSort}}{{range $col := (list "date" "name" "views")}}<option value="{{$col}}"{{if eq $sort $col}} selected{{end}}>{{t $.Lang (print "recent.sort_" $col)}}</option>{{end}}
                        </select>
                        <label class="form-label" for="pref-order">{{t .Lang "recent.order_label"}}</label>
                        <select id="pref-order" name="cairnbin_pref_order" class="form-select">
                            {{$order := .PrefOrder}}<option value="desc"{{if eq $order "desc"}} selected{{end}}>{{t .Lang "recent.order_desc"}}</option><option value="asc"{{if eq $order "asc"}} selected{{end}}>{{t .Lang "recent.order_asc"}}</option>
                        </select>
                        <label class="form-label" for="pref-per-page">{{t .Lang "recent.limit_label"}}</label>
                        <select id="pref-per-page" name="cairnbin_pref_per_page" class="form-select">
                            {{$perPage := .PrefPerPage}}{{range $n := (list "20" "50" "100" "250")}}<option value="{{$n}}"{{if eq $perPage $n}} selected{{end}}>{{$n}}</option>{{end}}
                        </select>
                        <h2 class="section-mt">{{t .Lang "preferences.export_title"}}</h2>
                        <label class="form-label" for="pref-export-url">{{t .Lang "preferences.export_url"}}</label>
                        <div class="copy-field"><input type="text" id="pref-export-url" class="form-input long-string preferences-export-value" value="{{.ExportURL}}" readonly><button type="button" class="copy-btn" data-copy="{{.ExportURL}}" aria-label="{{t .Lang "preferences.copy"}}">{{t .Lang "preferences.copy"}}</button></div>
                        <label class="form-label" for="pref-export-code">{{t .Lang "preferences.export_code"}}</label>
                        <div class="copy-field"><input type="text" id="pref-export-code" class="form-input long-string preferences-export-value" value="{{.ExportCode}}" readonly><button type="button" class="copy-btn" data-copy="{{.ExportCode}}" aria-label="{{t .Lang "preferences.copy"}}">{{t .Lang "preferences.copy"}}</button></div>
                        <label class="form-label" for="pref-import-code">{{t .Lang "preferences.import_code"}}</label>
                        <input type="text" id="pref-import-code" name="code" class="form-input long-string preferences-export-value" maxlength="2048" placeholder="{{t .Lang "preferences.import_placeholder"}}">
                        <div class="form-actions">
                            <a class="btn btn-secondary" href="{{.CancelURL}}">{{t .Lang "common.cancel"}}</a>
                            <button type="button" class="btn btn-secondary" popovertarget="preferences-reset">{{t .Lang "preferences.reset"}}</button>
                            <button type="submit" class="btn btn-primary">{{t .Lang "common.save"}}</button>
                        </div>
                        <div id="preferences-reset" popover>
                            <p>{{t .Lang "preferences.reset_warning"}}</p>
                            <button type="button" class="btn btn-secondary" popovertarget="preferences-reset" popovertargetaction="hide">{{t .Lang "common.cancel"}}</button>
                            <button type="submit" class="btn btn-danger" name="action" value="reset">{{t .Lang "preferences.erase"}}</button>
                        </div>
                    </form>

                    <p class="section-mt"><a href="/server/preferences/tokens">{{t .Lang "preferences.owner_tokens"}}</a></p>

                </div>
            </div>
        </section>
{{end}}
