{{define "meta" -}}
<title>{{t .Lang "terms.title"}}{{.TitleSeparator}}{{.SiteTitle}}</title>
<meta name="description" content="{{tf .Lang "terms.meta_description" "site" .SiteTitle}}">
{{end}}

{{define "content"}}
    <div class="container container-sm">
      <header class="page-header">
        <h1 class="page-title">{{t .Lang "terms.title"}}</h1>
      </header>

        <section class="section-card" aria-labelledby="terms-acceptance-heading">
          <h2 id="terms-acceptance-heading">{{t .Lang "terms.acceptance"}}</h2>
          {{if .OperatorTermsHTML}}<div class="markdown-content">{{.OperatorTermsHTML}}</div>{{else}}
          <p>{{t .Lang "terms.acceptance_text"}}</p>

          <h3>{{t .Lang "terms.acceptable_use"}}</h3>
          <p>{{t .Lang "terms.use_intro"}}</p>
          <ul class="feature-list">
            <li>{{t .Lang "terms.use_illegal"}}</li>
            <li>{{t .Lang "terms.use_malware"}}</li>
            <li>{{t .Lang "terms.use_credentials"}}</li>
            <li>{{t .Lang "terms.use_spam"}}</li>
          </ul>
          <p>{{t .Lang "terms.use_note"}}</p>

          <h3>{{t .Lang "terms.liability"}}</h3>
          <p>{{t .Lang "terms.liability_text"}}</p>

          <h3>{{t .Lang "terms.changes"}}</h3>
          <p>{{t .Lang "terms.changes_text"}}</p>

          <h3>{{t .Lang "terms.governing_law"}}</h3>
          <p>{{t .Lang "terms.governing_law_text"}}</p>
          {{end}}
        </section>
    </div>
{{end}}
