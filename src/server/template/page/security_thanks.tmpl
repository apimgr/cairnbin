{{define "meta" -}}
<title>{{t .Lang "security.thanks_title"}}{{.TitleSeparator}}{{.SiteTitle}}</title>
<meta name="description" content="{{tf .Lang "security.thanks_meta_description" "site" .SiteTitle}}">
{{end}}

{{define "content"}}
    <div class="container container-lg">
      <header class="page-header">
        <nav class="breadcrumb" aria-label="{{t .Lang "common.breadcrumb"}}"><a href="{{.AssetPrefix}}/server/security">← {{t .Lang "security.title"}}</a></nav>
        <h1 class="page-title">{{t .Lang "security.thanks_title"}}</h1>
        <p class="page-lead">{{tf .Lang "security.thanks_subtitle" "site" .SiteTitle}}</p>
      </header>

        <section class="section-card" aria-labelledby="security-researchers-heading">
          <h2 id="security-researchers-heading">{{t .Lang "security.researcher"}}</h2>
          {{if .Entries}}
          <p>
            {{t .Lang "security.thanks_intro"}}
            <a href="{{.AssetPrefix}}/server/security/policy">{{t .Lang "security.policy_title"}}</a>
          </p>
          <div class="table-wrapper">
          <table class="data-table">
              <thead>
                <tr>
                  <th scope="col">{{t .Lang "security.researcher"}}</th>
                  <th scope="col">{{t .Lang "security.component"}}</th>
                  <th scope="col">{{t .Lang "security.severity"}}</th>
                  <th scope="col">{{t .Lang "security.year"}}</th>
                </tr>
              </thead>
              <tbody>
                {{range .Entries}}
                <tr>
                  <td class="long-string">{{.Display}}</td>
                  <td>{{if .Component}}{{.Component}}{{else}}—{{end}}</td>
                  <td>{{if .Severity}}{{.Severity}}{{else}}—{{end}}</td>
                  <td>{{if .Year}}{{.Year}}{{else}}—{{end}}</td>
                </tr>
                {{end}}
              </tbody>
            </table>
          </div>
          {{else}}
          <p class="empty-state">
            {{t .Lang "security.thanks_empty"}}
            <a href="{{.AssetPrefix}}/server/security/policy">{{t .Lang "security.policy_title"}}</a>
          </p>
          {{end}}
        </section>
    </div>
{{end}}
