{{define "meta" -}}
<title>{{t .Lang "security.status_meta_title"}}{{.TitleSeparator}}{{.SiteTitle}}</title>
{{end}}

{{define "content"}}
    <div class="container container-sm">
      <header class="page-header">
        <nav class="breadcrumb" aria-label="{{t .Lang "common.breadcrumb"}}"><a href="{{.AssetPrefix}}/server/security">← {{t .Lang "security.title"}}</a></nav>
        <h1 class="page-title">{{t .Lang "security.status_title"}}</h1>
        <p class="page-lead long-string">{{t .Lang "security.tracking_id"}}: <code>{{.TrackingID}}</code></p>
      </header>

        <section class="section-card" aria-labelledby="security-current-status-heading">
          <h2 id="security-current-status-heading">{{t .Lang "security.current_status"}}</h2>
          {{if .RateLimited}}
          <div class="alert alert-warning" role="alert">
            {{t .Lang "security.status_rate_limited"}}
          </div>
          {{end}}

          <dl class="detail-list">
            <div class="detail-row">
              <dt>{{t .Lang "security.current_status"}}</dt>
              <dd><strong>{{.Status}}</strong></dd>
            </div>
            <div class="detail-row">
              <dt>{{t .Lang "security.severity"}}</dt>
              <dd>{{if .Severity}}{{.Severity}}{{else}}{{t .Lang "security.pending_triage"}}{{end}}</dd>
            </div>
            <div class="detail-row">
              <dt>{{t .Lang "security.component"}}</dt>
              <dd>{{if .Component}}{{.Component}}{{else}}—{{end}}</dd>
            </div>
            <div class="detail-row">
              <dt>{{t .Lang "security.received"}}</dt>
              <dd>{{.ReceivedAt}}</dd>
            </div>
            <div class="detail-row">
              <dt>{{t .Lang "security.last_updated"}}</dt>
              <dd>{{.UpdatedAt}}</dd>
            </div>
            <div class="detail-row">
              <dt>{{t .Lang "security.expected_disclosure"}}</dt>
              <dd>{{.ExpectedDate}}</dd>
            </div>
            {{if .DisclosedAt}}
            <div class="detail-row">
              <dt>{{t .Lang "security.disclosed"}}</dt>
              <dd>{{.DisclosedAt}}</dd>
            </div>
            {{end}}
          </dl>

          <h3>{{t .Lang "security.progress"}}</h3>
          <ol class="progress-stages">
            {{range .Stages}}
            <li class="progress-stage{{if eq . $.CurrentStage}} progress-stage-current{{end}}">{{.}}</li>
            {{end}}
          </ol>

          {{if .Comment}}
          <h3>{{t .Lang "security.maintainer_note"}}</h3>
          <blockquote class="maintainer-comment">{{.Comment}}</blockquote>
          {{end}}

          <h3>{{t .Lang "security.contact"}}</h3>
          <p>
            {{t .Lang "security.status_contact_text"}}
            {{if .SecurityEmail}}{{t .Lang "security.status_contact_email"}}
            <a href="mailto:{{.SecurityEmail}}" class="long-string">{{.SecurityEmail}}</a>{{end}}
          </p>
        </section>
    </div>
{{end}}
