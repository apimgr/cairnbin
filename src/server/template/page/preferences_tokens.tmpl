{{define "meta" -}}
<title>{{t .Lang "preferences.owner_tokens"}}{{.TitleSeparator}}{{.SiteTitle}}</title>
<meta name="description" content="{{t .Lang "preferences.token_desc"}}">
{{end}}

{{define "content"}}
    <div class="container container-lg">
      <header class="page-header">
        <nav class="breadcrumb" aria-label="{{t .Lang "common.breadcrumb"}}"><a href="{{.AssetPrefix}}/server/preferences">← {{t .Lang "preferences.title"}}</a></nav>
        <h1 class="page-title">{{t .Lang "preferences.owner_tokens"}}</h1>
        <p class="page-lead">{{t .Lang "preferences.token_desc"}}</p>
      </header>
      {{if .HasOwnerPrimary}}
      <div>
        <div>
          <section id="primary" class="section-card" aria-labelledby="owner-token-heading-1">
            <h2 id="owner-token-heading-1">{{t .Lang "preferences.owner_primary"}}</h2>
            {{range .OwnerTokens}}
            {{if eq .kind "primary"}}<p><code class="copy-value">{{.token_masked}}</code></p>
            <p>{{t $.Lang "preferences.owner_created_at"}} <time>{{.created_at}}</time> UTC</p>
            {{if .last_used_at}}<p>{{t $.Lang "preferences.owner_last_used_at"}} <time>{{.last_used_at}}</time> UTC</p>{{end}}
            {{if .expires_at}}<p>{{t $.Lang "preferences.owner_expires_at"}} <time>{{.expires_at}}</time> UTC</p>{{end}}{{end}}
            {{end}}
            <div>
              <form method="post" action="{{.AssetPrefix}}/server/preferences/token/reveal">
                <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                <button type="submit" class="btn btn-secondary">{{t .Lang "preferences.owner_reveal"}}</button>
              </form>
              <button type="button" class="btn btn-danger" popovertarget="rotate-primary">{{t .Lang "preferences.owner_rotate"}}</button>
              <div id="rotate-primary" popover>
                <p>{{t .Lang "preferences.owner_confirm_rotate_primary"}}</p>
                <form method="post" action="{{.AssetPrefix}}/server/preferences/token/rotate">
                  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                  <button type="submit" class="btn btn-danger">{{t .Lang "preferences.owner_rotate"}}</button>
                </form>
                <button type="button" class="btn btn-secondary" popovertarget="rotate-primary" popovertargetaction="hide">{{t .Lang "common.cancel"}}</button>
              </div>
            </div>
            {{if .RevealedOwnerToken}}
            <p><code class="copy-value">{{.RevealedOwnerToken}}</code> <button type="button" class="copy-btn" data-copy="{{.RevealedOwnerToken}}" aria-label="{{t .Lang "preferences.owner_copy"}}">{{t .Lang "preferences.owner_copy"}}</button></p>
            <p>{{t .Lang "preferences.owner_shown_once"}}</p>
            {{end}}
          </section>
          <section class="section-card" aria-labelledby="owner-token-heading-2">
            <h2 id="owner-token-heading-2">{{t .Lang "preferences.owner_create_linked"}}</h2>
            <form method="post" action="{{.AssetPrefix}}/server/preferences/tokens" >
              <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
              <label for="linked-token-name" class="form-label">{{t .Lang "preferences.owner_name"}}</label>
              <input id="linked-token-name" name="name" maxlength="64" required class="form-input">
              <label for="linked-token-expiry" class="form-label">{{t .Lang "preferences.owner_expiry"}}</label>
              <select id="linked-token-expiry" name="expires" class="form-input"><option value="never">{{t .Lang "preferences.owner_never"}}</option><option value="7d">{{t .Lang "preferences.owner_7_days"}}</option><option value="30d">{{t .Lang "preferences.owner_30_days"}}</option><option value="90d">{{t .Lang "preferences.owner_90_days"}}</option><option value="1y">{{t .Lang "preferences.owner_1_year"}}</option><option value="custom">{{t .Lang "preferences.owner_custom_date"}}</option></select>
              <details >
                <summary>{{t .Lang "preferences.owner_custom_date"}}</summary>
                <label for="linked-token-date" class="form-label">{{t .Lang "preferences.owner_expires_on"}}</label>
                <input id="linked-token-date" type="date" name="expires_on" class="form-input">
              </details>
              <button type="submit" class="btn btn-primary">{{t .Lang "preferences.owner_create"}}</button>
            </form>
          </section>
          <section class="section-card" aria-labelledby="owner-token-heading-3">
            <h2 id="owner-token-heading-3">{{t .Lang "preferences.token_title"}}</h2>
            <p>{{t .Lang "preferences.token_desc"}}</p>
            <button type="button" class="btn btn-secondary" data-action="forget-token">{{t .Lang "paste.forget_token"}}</button>
          </section>
        </div>
        <section class="section-card" aria-labelledby="owner-token-heading-4">
            <h2 id="owner-token-heading-4">{{t .Lang "preferences.owner_linked"}}</h2>
          {{if not .HasLinkedTokens}}<p class="empty-state">{{t .Lang "preferences.owner_no_linked"}}</p>{{end}}
          {{range .OwnerTokens}}
          {{if eq .kind "linked"}}
          <article id="token-{{.id}}">
            <h3>{{.name}}</h3>
            <p>{{t $.Lang "preferences.owner_linked"}} · {{t $.Lang (print "preferences.owner_" .status)}}</p>
            <p><code class="copy-value">{{.token_masked}}</code></p>
            <p>{{t $.Lang "preferences.owner_created_at"}} <time>{{.created_at}}</time> UTC</p>
            {{if .last_used_at}}<p>{{t $.Lang "preferences.owner_last_used_at"}} <time>{{.last_used_at}}</time> UTC</p>{{end}}
            {{if .expires_at}}<p>{{t $.Lang "preferences.owner_expires_at"}} <time>{{.expires_at}}</time> UTC</p>{{end}}
            {{if and $.RevealedLinkedToken (eq $.RevealedLinkedTokenID .id)}}<p><code class="copy-value">{{$.RevealedLinkedToken}}</code> <button type="button" class="copy-btn" data-copy="{{$.RevealedLinkedToken}}">{{t $.Lang "preferences.owner_copy"}}</button></p><p>{{t $.Lang "preferences.owner_shown_once"}}</p>{{end}}
            <div>
          <form method="post" action="{{$.AssetPrefix}}/server/preferences/tokens/{{.id}}/reveal" >
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <button type="submit" class="btn btn-secondary">{{t $.Lang "preferences.owner_reveal"}}</button>
          </form>
          <button type="button" class="btn btn-danger" popovertarget="rotate-token-{{.id}}">{{t $.Lang "preferences.owner_rotate"}}</button>
          <div id="rotate-token-{{.id}}" popover>
            <p>{{t $.Lang "preferences.owner_confirm_rotate"}}</p>
            <form method="post" action="{{$.AssetPrefix}}/server/preferences/tokens/{{.id}}/rotate">
              <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
              <button type="submit" class="btn btn-danger">{{t $.Lang "preferences.owner_rotate"}}</button>
            </form>
            <button type="button" class="btn btn-secondary" popovertarget="rotate-token-{{.id}}" popovertargetaction="hide">{{t $.Lang "common.cancel"}}</button>
          </div>
          <details >
            <summary>{{t $.Lang "preferences.owner_rename"}}</summary>
            <form method="post" action="{{$.AssetPrefix}}/server/preferences/tokens/{{.id}}/update" >
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <label class="form-label" for="tok-{{.id}}-name">{{t $.Lang "preferences.owner_rename"}}</label><input id="tok-{{.id}}-name" name="name" value="{{.name}}" maxlength="64" required class="form-input">
            <label class="form-label" for="tok-{{.id}}-expires">{{t $.Lang "preferences.owner_expiry"}}</label><select id="tok-{{.id}}-expires" name="expires" class="form-input"><option value="" selected>{{t $.Lang "preferences.owner_keep_expiry"}}</option><option value="never">{{t $.Lang "preferences.owner_never"}}</option><option value="7d">{{t $.Lang "preferences.owner_7_days"}}</option><option value="30d">{{t $.Lang "preferences.owner_30_days"}}</option><option value="90d">{{t $.Lang "preferences.owner_90_days"}}</option><option value="1y">{{t $.Lang "preferences.owner_1_year"}}</option><option value="custom">{{t $.Lang "preferences.owner_custom_date"}}</option></select>
            <details >
              <summary>{{t $.Lang "preferences.owner_custom_date"}}</summary>
              <label class="form-label" for="tok-{{.id}}-date">{{t $.Lang "preferences.owner_expires_on"}}</label>
              <input id="tok-{{.id}}-date" type="date" name="expires_on" class="form-input">
            </details>
            <button type="submit" class="btn btn-secondary">{{t $.Lang "preferences.owner_save"}}</button>
            </form>
          </details>
          <button type="button" class="btn btn-danger" popovertarget="revoke-token-{{.id}}">{{t $.Lang "preferences.owner_revoke"}}</button>
          <div id="revoke-token-{{.id}}" popover>
            <p>{{t $.Lang "preferences.owner_confirm_revoke"}}</p>
            <form method="post" action="{{$.AssetPrefix}}/server/preferences/tokens/{{.id}}/revoke">
              <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
              <button type="submit" class="btn btn-danger">{{t $.Lang "preferences.owner_revoke"}}</button>
            </form>
            <button type="button" class="btn btn-secondary" popovertarget="revoke-token-{{.id}}" popovertargetaction="hide">{{t $.Lang "common.cancel"}}</button>
          </div>
            </div>
          </article>
          {{end}}
          {{end}}
        </section>
      </div>
      {{else}}
      <section class="section-card" aria-labelledby="owner-restore-heading"><h2 id="owner-restore-heading">{{t .Lang "preferences.owner_restore"}}</h2>
          <form method="post" action="{{.AssetPrefix}}/server/preferences/token/restore" >
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <label for="restore-owner-token" class="form-label">{{t .Lang "preferences.owner_use_primary"}}</label>
            <input id="restore-owner-token" name="owner_token" type="password" class="form-input" required autocomplete="off">
            <button type="submit" class="btn btn-primary">{{t .Lang "preferences.owner_restore"}}</button>
          </form>
      </section>
      {{end}}
    </div>
{{end}}
