{{define "headAssets"}}
    <meta name="theme-color" content="{{.ThemeColor}}">
    {{.SEOMeta}}
    <link rel="manifest" href="{{.AssetPrefix}}/manifest.json">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="{{.SiteTitle}}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{.AssetPrefix}}/static/branding/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="{{.AssetPrefix}}/static/branding/favicon-16.png">
    <link rel="apple-touch-icon" href="{{asset .AssetPrefix "/static/icons/icon-180.png"}}">
    <link rel="stylesheet" href="{{asset .AssetPrefix "/static/css/common.css"}}">
    <link rel="stylesheet" href="{{asset .AssetPrefix "/static/css/components.css"}}">
    <link rel="stylesheet" href="{{asset .AssetPrefix "/static/css/public.css"}}">
{{end}}
