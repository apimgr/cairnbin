{{define "footer"}}
<footer class="footer">
    <div class="footer-content">
        {{if .FooterCustomHTML}}
        <div class="footer-brand">{{.FooterCustomHTML}}</div>
        {{end}}
        {{if and .TorEnabled .TorRunning .OnionAddress}}
        <p class="footer-onion">
            <a href="{{.AssetPrefix}}/server/help#tor-access" class="footer-onion-icon" aria-label="{{t .Lang "footer.tor_support"}}">🧅</a>
            <code class="footer-onion-address onion-address">{{.OnionAddress}}</code>
            <button type="button" class="footer-onion-copy copy-btn" data-copy="{{.OnionAddress}}" aria-live="polite" aria-label="{{t .Lang "footer.copy_onion"}}">
                <span class="copy-text">📋</span>
            </button>
        </p>
        {{end}}
        {{if and .I2PEnabled .I2PRunning .I2PAddress}}
        <p class="footer-i2p">
            <a href="{{.AssetPrefix}}/server/help#i2p-access" class="footer-i2p-icon" aria-label="{{t .Lang "footer.i2p_support"}}">🔗</a>
            <code class="footer-i2p-address i2p-address">{{.I2PAddress}}</code>
            <button type="button" class="footer-i2p-copy copy-btn" data-copy="{{.I2PAddress}}" aria-live="polite" aria-label="{{t .Lang "footer.copy_i2p"}}">
                <span class="copy-text">📋</span>
            </button>
        </p>
        {{end}}
        <nav class="footer-links" aria-label="{{t .Lang "footer.navigation"}}">
            <a href="{{.AssetPrefix}}/server/about" class="footer-link">{{t .Lang "footer.about"}}</a>
            <span class="footer-sep" aria-hidden="true">·</span>
            <a href="{{.AssetPrefix}}/server/privacy" class="footer-link">{{t .Lang "footer.privacy"}}</a>
            <span class="footer-sep" aria-hidden="true">·</span>
            <a href="{{.AssetPrefix}}/server/contact" class="footer-link">{{t .Lang "footer.contact"}}</a>
            <span class="footer-sep" aria-hidden="true">·</span>
            <a href="{{.AssetPrefix}}/server/help" class="footer-link">{{t .Lang "footer.help"}}</a>
            <span class="footer-sep" aria-hidden="true">·</span>
            <a href="{{.AssetPrefix}}/server/preferences" class="footer-link">{{t .Lang "footer.preferences"}}</a>
        </nav>
        {{if gt (len .AvailableLanguages) 1}}
        <form method="get" action="" class="lang-selector">
            <label for="lang-select" class="sr-only">{{t .Lang "common.select_language"}}</label>
            <select name="lang" id="lang-select" class="lang-select">
                {{range .AvailableLanguages}}
                <option value="{{.Code}}" lang="{{.Code}}"{{if eq .Code $.Lang}} selected{{end}}>{{.NativeName}}</option>
                {{end}}
            </select>
            <button type="submit" class="btn btn-secondary lang-selector-go">{{t .Lang "common.submit"}}</button>
        </form>
        {{end}}
        <p class="footer-made">
            <a href="{{.RepoURL}}" target="_blank" rel="noopener noreferrer" class="footer-repo">{{t .Lang "footer.made_with"}}</a> ❤️
            <span class="footer-sep" aria-hidden="true">·</span>
            <span class="footer-version">{{.Version}}</span>
        </p>
        <p class="footer-meta">
            <a href="{{.AssetPrefix}}/server/healthz" class="footer-update">{{t .Lang "footer.last_update"}}: {{.BuildDate}}</a>
        </p>
        <div class="footer-install" hidden>
            <button type="button" class="footer-link footer-install-btn" data-action="install-app">{{t .Lang "pwa.install"}}</button>
        </div>
    </div>
</footer>
<dialog id="ios-install-dialog" class="install-dialog" aria-labelledby="ios-install-title">
    <h2 id="ios-install-title" class="install-dialog-title">{{t .Lang "pwa.ios_install_title"}}</h2>
    <ol class="install-dialog-steps">
        <li>{{t .Lang "pwa.ios_step_share"}}</li>
        <li>{{t .Lang "pwa.ios_step_add"}}</li>
        <li>{{t .Lang "pwa.ios_step_confirm"}}</li>
    </ol>
    <form method="dialog" class="install-dialog-actions">
        <button type="submit" class="btn btn-secondary">{{t .Lang "common.close"}}</button>
    </form>
</dialog>
<dialog id="confirm-dialog" class="install-dialog" aria-labelledby="confirm-dialog-title" aria-describedby="confirm-dialog-message">
    <h2 id="confirm-dialog-title" class="install-dialog-title">{{t .Lang "confirm.action_title"}}</h2>
    <p id="confirm-dialog-message" class="confirm-dialog-message"></p>
    <form method="dialog" class="install-dialog-actions">
        <button type="submit" value="cancel" class="btn btn-secondary">{{t .Lang "common.cancel"}}</button>
        <button type="submit" value="confirm" class="btn btn-danger">{{t .Lang "common.confirm"}}</button>
    </form>
</dialog>
{{if .TrackingAllowed}}
<template id="pb-tracking-snippet">{{trackingScript}}</template>
{{end}}
<script type="application/json" id="pb-consent-data">{{consentConfig .Lang}}</script>
{{if and (not .HasConsented) (ne .CurrentPath "/server/preferences")}}
{{$c := consentInfo .Lang}}
<div id="cookie-consent" class="cookie-banner cookie-banner-bottom" data-sold="{{if $c.DataSold}}true{{else}}false{{end}}">
  <div class="cookie-banner-content">
    <span class="cookie-message">{{$c.Message}} - <a href="{{$c.PolicyURL}}" class="policy-link">{{$c.PolicyText}}</a></span>
    <div class="cookie-buttons">
      {{if $c.ShowPreferences}}<a href="{{.AssetPrefix}}/server/preferences" class="btn-preferences policy-link">{{$c.PreferencesText}}</a>{{end}}
      <form method="post" action="{{.AssetPrefix}}/server/consent">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="choice" value="decline">
        <button type="submit" class="btn-decline">{{$c.DeclineText}}</button>
      </form>
      <form method="post" action="{{.AssetPrefix}}/server/consent">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="choice" value="accept">
        <button type="submit" class="btn-accept">{{$c.AcceptText}}</button>
      </form>
    </div>
  </div>
</div>
{{end}}
{{end}}
