{{define "header"}}
  <a href="#main-content" class="skip-link">{{t .Lang "nav.skip_to_content"}}</a>
  <a href="#navigation" class="skip-link">{{t .Lang "nav.skip_to_navigation"}}</a>
  {{$c := consentInfo .Lang}}
  <div id="site-banner-stack" data-position="{{if and (not .HasConsented) (ne .CurrentPath "/server/preferences")}}{{$c.Position}}{{else}}top{{end}}">
  {{if and (not .HasConsented) (ne .CurrentPath "/server/preferences")}}
  <div id="cookie-consent" class="cookie-banner cookie-banner-{{$c.Position}}" data-sold="{{if $c.DataSold}}true{{else}}false{{end}}">
    <div class="cookie-banner-content">
      <span class="cookie-message">{{$c.Message}} - <a href="{{$c.PolicyURL}}" class="policy-link">{{$c.PolicyText}}</a></span>
      <div class="cookie-buttons">
        {{if $c.ShowPreferences}}<a href="{{.AssetPrefix}}/server/preferences" class="btn-preferences policy-link">{{$c.PreferencesText}}</a>{{end}}
        <form method="post" action="{{.AssetPrefix}}/server/consent">
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          <input type="hidden" name="choice" value="decline">
          <button type="submit" class="btn-decline">{{$c.DeclineText}}</button>
        </form>
        <form method="post" action="{{.AssetPrefix}}/server/consent">
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          <input type="hidden" name="choice" value="accept">
          <button type="submit" class="btn-accept">{{$c.AcceptText}}</button>
        </form>
      </div>
    </div>
  </div>
  {{end}}
  {{if ne .CurrentPath "/server/preferences"}}{{range .Announcements}}
  <div class="site-banner site-banner-{{.Type}}" role="{{.Role}}" data-announcement-id="{{.ID}}">
    <span class="site-banner-icon" aria-hidden="true">{{.Icon}}</span>
    <span class="site-banner-text">{{if .Title}}<strong>{{.Title}}:</strong> {{end}}{{.Message}}</span>
    {{if .Dismissible}}
    <form method="post" action="{{$.AssetPrefix}}/announcements/dismiss" class="site-banner-dismiss">
      <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
      <input type="hidden" name="id" value="{{.ID}}">
      <input type="hidden" name="return_to" value="{{$.CurrentPath}}">
      <button type="submit" class="site-banner-close" aria-label="{{t $.Lang "announcements.dismiss"}}">&times;</button>
    </form>
    {{end}}
  </div>
  {{end}}{{end}}
  <div id="pwa-update-banner-slot" aria-live="polite"></div>
  </div>
  {{if .Flash}}
  <div class="flash flash-{{.Flash.Kind}}" role="status">{{.Flash.Message}}</div>
  {{end}}
  {{if .PreferencesConsentRequired}}
  <div class="container" role="status"><p class="alert alert-warning">{{t .Lang "preferences.consent_required_notice"}} <a href="{{.AssetPrefix}}/server/preferences#preferences-privacy">{{t .Lang "preferences.consent_title"}}</a></p></div>
  {{end}}
  <header class="header">
    <a href="{{.AssetPrefix}}/" class="site-brand">
      <img src="{{asset .AssetPrefix "/static/branding/logo-50.png"}}" alt="{{.SiteTitle}}" class="site-brand-logo">
      <span>{{.SiteTitle}}</span>
    </a>
  {{template "nav" .}}
  </header>
{{end}}
