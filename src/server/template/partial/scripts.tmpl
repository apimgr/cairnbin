  <script type="application/json" id="pb-i18n-data"{{if .CSPNonce}} nonce="{{.CSPNonce}}"{{end}}>{{i18njs .Lang}}</script>
  <script src="{{asset .AssetPrefix "/static/js/app.js"}}"{{if .CSPNonce}} nonce="{{.CSPNonce}}"{{end}}></script>
{{end}}
