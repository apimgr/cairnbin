/* ============================================
   Base & Reset
   ============================================ */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    font-size: 16px;
    scroll-behavior: smooth;
    overflow-x: clip;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

body {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: var(--color-text-primary);
    background: var(--color-bg-primary);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* Typography */
h1, h2, h3, h4, h5, h6 {
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
}

a {
    color: var(--color-accent-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
}

a:hover {
    color: var(--color-accent-hover);
}

code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.125rem 0.375rem;
    background: var(--color-code-bg);
    border-radius: var(--radius-base);
    word-break: break-word;
}

/* Semantic inline elements (PART 16 Semantic HTML Elements) */
kbd {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.125rem 0.375rem;
    color: var(--color-text);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: var(--radius-base);
}

samp {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.125rem 0.375rem;
    color: var(--color-muted);
    background: var(--color-code-bg);
    border-radius: var(--radius-base);
}

var {
    font-family: var(--font-mono);
    font-style: italic;
}

mark {
    padding: 0 0.25rem;
    color: var(--color-text);
    background: var(--color-warning-bg);
    border-radius: var(--radius-base);
}

abbr[title] {
    text-decoration: underline dotted;
    cursor: help;
}

time {
    white-space: nowrap;
}


/* ============================================
   Animations
   ============================================ */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-fade-in-up {
    animation: fadeInUp calc(0.5s * var(--motion-scale)) ease forwards;
}

/* Stagger animations */
.results-grid > * {
    animation: fadeInUp calc(0.4s * var(--motion-scale)) ease forwards;
    opacity: 0;
}

.results-grid > *:nth-child(1) { animation-delay: calc(0.05s * var(--motion-scale)); }
.results-grid > *:nth-child(2) { animation-delay: calc(0.1s * var(--motion-scale)); }
.results-grid > *:nth-child(3) { animation-delay: calc(0.15s * var(--motion-scale)); }
.results-grid > *:nth-child(4) { animation-delay: calc(0.2s * var(--motion-scale)); }
.results-grid > *:nth-child(5) { animation-delay: calc(0.25s * var(--motion-scale)); }
.results-grid > *:nth-child(6) { animation-delay: calc(0.3s * var(--motion-scale)); }

/* ============================================
   Utility Classes
   ============================================ */
.text-center { text-align: center; }
.text-muted { color: var(--color-text-muted); }
.mt-4 { margin-top: var(--space-4); }
.mt-8 { margin-top: var(--space-8); }
.mb-4 { margin-bottom: var(--space-4); }
.mb-8 { margin-bottom: var(--space-8); }
.ml-auto { margin-inline-start: auto; }

/* ============================================
   Long String Utilities (PART 16)
   Required for IPv6, .onion, tokens, hashes, UUIDs, Base64
   ============================================ */
.long-string,
.ip-address,
.api-token,
.hash,
.uuid,
.monospace-data {
    word-break: break-all;
    overflow-wrap: break-word;
    font-family: monospace;
}

/* Values with an adjacent copy button: single-line scroll, never wrap —
   wrapping would break the copy target across multiple lines. */
.onion-address,
.i2p-address,
.copy-value {
    display: inline-block;
    max-width: 100%;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
    font-family: monospace;
    font-size: 0.875rem;
}


/* ============================================
   Spacing Utilities
   ============================================ */
.mt-2 { margin-top: var(--space-2); }
.mt-3 { margin-top: var(--space-3); }
.mt-4 { margin-top: var(--space-4); }
.mb-2 { margin-bottom: var(--space-2); }
.d-block { display: block; }

/* ============================================
   Text Color Utilities
   ============================================ */
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }


/* ============================================
   Screen-Reader-Only Text (WCAG 2.1 AA — PART 16, PART 28-30)
   ============================================ */
/* The hidden attribute must win over component display rules */
[hidden] {
    display: none;
}

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}


/* ============================================
   Skip Link (WCAG 2.1 AA — PART 16)
   ============================================ */
.skip-link {
    position: absolute;
    top: -100%;
    inset-inline-start: var(--space-4);
    z-index: 20000;
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent-primary);
    color: var(--color-on-accent);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-decoration: none;
    transition: top var(--transition-fast);
}

.skip-link:focus {
    top: var(--space-4);
}


/* ============================================
   Focus Indicators (WCAG 2.1 AA — PART 16)
   Visible :focus-visible ring on every focusable element
   ============================================ */
a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
summary:focus-visible,
[tabindex]:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
}


/* ============================================
   Reduced Motion (WCAG 2.1 AA — PART 16)
   ============================================ */
@media (prefers-reduced-motion: reduce) {
    :root {
        --motion-scale: 0;
        --transition-fast: 0.01ms ease;
        --transition-base: 0.01ms ease;
        --transition-slow: 0.01ms ease;
    }

    html {
        scroll-behavior: auto;
    }
}


/* ============================================
   Print Styles (PART 16)
   ============================================ */
@media print {
    header,
    nav,
    footer,
    .nav-toggle,
    .nav-panel,
    .nav-overlay,
    .no-print,
    button:not(.print-include),
    .toast,
    .modal {
        display: none !important;
    }

    body {
        background: white !important;
        color: black !important;
    }

    main, .container {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    a[href^="http"]:after {
        content: " (" attr(href) ")";
        font-size: 0.8em;
        color: #666;
    }

    pre, blockquote, table, img {
        page-break-inside: avoid;
    }

    h1, h2 {
        page-break-after: avoid;
    }
}

.print-only {
    display: none;
}

@media print {
    .print-only {
        display: block;
    }
}
