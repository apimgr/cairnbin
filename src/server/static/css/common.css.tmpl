/* ============================================
   CAIRNBIN - common.css
   Reset, design tokens (CSS variables), and
   cross-context utility classes.
   Load order (AI.md PART 16): common -> components -> public
   ============================================ */

/* ============================================
   CAIRNBIN - Professional UI Design System
   Modern, Clean, Professional Design
   ============================================ */

/* CSS Custom Properties - Design Tokens */
:root {
    /* Canonical palette (PART 16) — rendered server-side from
       src/common/theme/colors.go (theme.ThemePaletteDark), the single
       source of truth for color values shared across Web CSS, TUI,
       Swagger, and GraphQL (AI.md:24320). */
    --bg: {{.Dark.Background}};
    --fg: {{.Dark.Foreground}};
    --accent: {{.Dark.Primary}};

    /* Colors - Dark Theme (Default) */
    --color-bg-primary: {{.Dark.Background}};
    --color-bg-secondary: {{.Dark.SurfaceAlt}};
    --color-bg-tertiary: {{.Dark.Background}};
    --color-bg-elevated: {{.Dark.Surface}};

    --color-text-primary: {{.Dark.Foreground}};
    --color-text-secondary: {{.Dark.Foreground}};
    --color-text-muted: {{.Dark.Muted}};
    --color-text-inverse: {{.Dark.Background}};

    --color-accent-primary: {{.Dark.Primary}};
    --color-accent-secondary: {{.Dark.Accent}};
    --color-accent-gradient: linear-gradient(135deg, {{.Dark.Primary}} 0%, {{.Dark.Accent}} 100%);
    --color-accent-hover: {{.Dark.Primary}};
    --color-accent-glow: rgba(137, 180, 250, 0.4);

    --color-success: {{.Dark.Success}};
    --color-warning: {{.Dark.Warning}};
    --color-error: {{.Dark.Error}};
    --color-info: {{.Dark.Info}};

    --color-border: rgba(255, 255, 255, 0.08);
    --color-border-focus: var(--color-accent-primary);

    /* Text color rendered on top of accent / status fills */
    --color-on-accent: #ffffff;

    /* Translucent surface overlay used behind the header */
    --color-surface-blur: rgba(30, 30, 46, 0.85);

    /* Tinted status / accent backgrounds (subtle fills) */
    --color-accent-tint: rgba(137, 180, 250, 0.1);
    --color-accent-tint-strong: rgba(137, 180, 250, 0.15);
    --color-success-tint: rgba(16, 185, 129, 0.15);
    --color-success-tint-soft: rgba(16, 185, 129, 0.1);
    --color-success-tint-12: rgba(16, 185, 129, 0.12);
    --color-info-tint: rgba(59, 130, 246, 0.15);
    --color-warning-tint: rgba(245, 158, 11, 0.15);
    --color-warning-tint-12: rgba(245, 158, 11, 0.12);
    --color-error-tint: rgba(239, 68, 68, 0.15);
    --color-error-tint-soft: rgba(239, 68, 68, 0.1);
    --color-error-tint-12: rgba(239, 68, 68, 0.12);
    --color-error-strong: #dc2626;

    /* Shadows */
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.5);
    --shadow-glow: 0 0 40px var(--color-accent-glow);

    /* Typography */
    --font-mono: "JetBrains Mono", "Fira Code", "Cascadia Code", ui-monospace,
        SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New",
        monospace;
    --font-sans: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, Oxygen, Ubuntu, Cantarell, "Helvetica Neue", Arial, sans-serif;
    --font-serif: "Lora", Georgia, "Times New Roman", Times, serif;

    --font-weight-normal: 400;
    --font-weight-medium: 500;
    --font-weight-semibold: 600;
    --font-weight-bold: 700;
    --line-height-tight: 1.25;
    --line-height-normal: 1.5;
    --line-height-relaxed: 1.75;

    --font-size-xs: 0.75rem;
    --font-size-sm: 0.875rem;
    --font-size-base: 1rem;
    --font-size-lg: 1.125rem;
    --font-size-xl: 1.25rem;
    --font-size-2xl: 1.5rem;
    --font-size-3xl: 2rem;
    --font-size-4xl: 2.5rem;
    --font-size-5xl: 3.5rem;

    /* Spacing */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-20: 5rem;
    --space-0: 0;
    --space-px: 1px;
    --space-7: 1.75rem;
    --space-24: 6rem;

    /* Border Radius */
    --radius-sm: 0.375rem;
    --radius-md: 0.5rem;
    --radius-lg: 0.75rem;
    --radius-xl: 1rem;
    --radius-2xl: 1.5rem;
    --radius-full: 9999px;
    --radius-none: 0;
    --radius-base: 0.25rem;
    --radius-3xl: 1.5rem;

    /* Z-index layers */
    --z-below: -1;
    --z-base: 0;
    --z-raised: 10;
    --z-dropdown: 100;
    --z-sticky: 200;
    --z-overlay: 300;
    --z-modal: 400;
    --z-toast: 500;
    --z-tooltip: 600;

    /* Extra shadow steps */
    --shadow-base: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
    --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    --shadow-inner: inset 0 2px 4px 0 rgb(0 0 0 / 0.05);

    /* Focus ring */
    --focus-ring: 0 0 0 3px var(--color-primary);
    --focus-ring-offset: 0 0 0 2px var(--color-bg), 0 0 0 4px var(--color-primary);

    /* Transitions */
    --motion-scale: 1;
    --transition-fast: 150ms ease;
    --transition-base: 200ms ease;
    --transition-slow: 300ms ease;
    --transition-spring: 300ms cubic-bezier(0.34, 1.56, 0.64, 1);

    /* Spec-exact aliases (AI.md PART 16, CSS Variable Reference §21415) —
       every component is required to be themeable through these exact
       property names; they resolve to the same tokens defined above. */
    --color-bg: {{.Dark.Background}};
    --color-bg-card: {{.Dark.Surface}};
    --color-bg-hover: #343746;
    --color-bg-active: {{.Dark.Border}};
    --color-code-bg: rgba(255, 255, 255, 0.1);
    --color-border-hover: {{.Dark.Muted}};
    --color-info-bg: rgba(139, 233, 253, 0.15);
    --color-secondary: {{.Dark.Secondary}};
    --color-accent: {{.Dark.Accent}};
    --color-on-error: #ffffff;
    --color-text: {{.Dark.Foreground}};
    --color-muted: {{.Dark.Muted}};
    --color-primary: {{.Dark.Primary}};
    --color-primary-bg: var(--color-accent-tint);
    --color-success-bg: var(--color-success-tint);
    --color-warning-bg: var(--color-warning-tint);
    --color-error-bg: var(--color-error-tint);
}

/* Auto Theme (PART 16, AI.md 23298): pure CSS — when the server renders
   html.theme-auto and the OS prefers light, override the dark-default tokens */
@media (prefers-color-scheme: light) {
    html.theme-auto {
        --bg: {{.Light.Background}};
        --fg: {{.Light.Foreground}};
        --accent: {{.Light.Primary}};

        --color-bg-primary: {{.Light.Background}};
        --color-bg-secondary: {{.Light.Surface}};
        --color-bg-tertiary: {{.Light.Background}};
        --color-bg-elevated: {{.Light.Surface}};
        --color-bg-hover: {{.Light.SurfaceAlt}};

        --color-text-primary: {{.Light.Foreground}};
        --color-text-secondary: {{.Light.Foreground}};
        --color-text-muted: {{.Light.Muted}};
        --color-text-inverse: {{.Light.Background}};

        --color-accent-primary: {{.Light.Primary}};
        --color-accent-secondary: {{.Light.Accent}};
        --color-accent-gradient: linear-gradient(135deg, {{.Light.Primary}} 0%, {{.Light.Accent}} 100%);
        --color-accent-hover: {{.Light.Primary}};

        --color-success: {{.Light.Success}};
        --color-warning: {{.Light.Warning}};
        --color-error: {{.Light.Error}};
        --color-info: {{.Light.Info}};

        --color-border: rgba(0, 0, 0, 0.08);
        --color-border-hover: #818b98;

        --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
        --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.12);

        --color-surface-blur: rgba(255, 255, 255, 0.9);

        /* Spec-exact aliases (AI.md PART 16, CSS Variable Reference §21415) */
        --color-bg: {{.Light.Background}};
        --color-bg-card: {{.Light.Background}};
        --color-bg-active: #e6eaef;
        --color-info-bg: rgba(9, 105, 218, 0.12);
        --color-secondary: {{.Light.Secondary}};
        --color-accent: {{.Light.Accent}};
        --color-on-error: #ffffff;
        --color-code-bg: rgba(0, 0, 0, 0.05);
        --color-text: {{.Light.Foreground}};
        --color-muted: {{.Light.Muted}};
        --color-primary: {{.Light.Primary}};
        --color-primary-bg: var(--color-accent-tint);
        --color-success-bg: var(--color-success-tint);
        --color-warning-bg: var(--color-warning-tint);
        --color-error-bg: var(--color-error-tint);
    }
}

